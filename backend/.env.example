# HazardShield AI - Backend Environment Configuration

# Database Configuration (MySQL Primary with automatic SQLite fallback)
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/hazardshield_db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://hazardshieldai.netlify.app

# OpenStreetMap & Geospatial Services
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
ROUTING_API_URL=https://router.project-osrm.org
GEOCODING_API_URL=https://nominatim.openstreetmap.org

# Application Environment
ENVIRONMENT=production
PROVENANCE_LABEL=HazardShield AI SIH Prototype Dataset
